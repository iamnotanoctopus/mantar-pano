# ---- Veri modu (istemci, derleme zamanı) -------------------------------------
# http  (varsayılan) → Hono sunucusu üzerinden Notion API
# local              → tarayıcıda localStorage; sunucu gerekmez (npm run build:static bunu ayarlar)
# mcp                → claude.ai artifact; görüntüleyenin Notion bağlayıcısı (npm run build:artifact)
VITE_API_MODE=http

# ---- Notion bağlantısı (http modu / sunucu) ------------------------------------
# 1) https://www.notion.so/profile/integrations → "New integration" (Internal).
#    Capabilities: Read content, Update content, Insert content.
# 2) "Internal Integration Secret" değerini aşağıya yapıştır.
# 3) Notion'da pano sayfasını aç → sağ üst "..." → "Connections" → entegrasyonu ekle.
NOTION_TOKEN=

# Görev veritabanının veri kaynağı (data source) kimliği. Bilmiyorsan NOTION_DATABASE_ID ver;
# sunucu ilk veri kaynağını kendisi bulur.
NOTION_DATA_SOURCE_ID=
NOTION_DATABASE_ID=

# Notion API sürümü (data source uçları için 2025-09-03 gerekir).
NOTION_VERSION=2025-09-03

# Token boşsa sunucu "demo" modunda çalışır: örnek kartlar server/data/tasks.json dosyasında tutulur.
# DATA_MODE=demo diyerek token olsa bile demo modunu zorlayabilirsin.
DATA_MODE=auto

# Sunucu portu
PORT=8787

# İsteğe bağlı: sunucuyu internete açarsan buraya bir şifre yaz. Uygulama ilk açılışta şifreyi sorar.
APP_PASSWORD=
